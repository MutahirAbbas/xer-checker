{
  "name": "xer-checker",
  "version": "0.1.0",
  "private": true,
  "description": "Reads Primavera P6 .xer exports, flags untrustworthy rows, runs three schedule checks, writes one HTML report.",
  "type": "module",
  "scripts": {
    "check": "tsx src/cli.ts",
    "check:fixture": "tsx src/cli.ts tests/fixture.xer --report fixture-report.html",
    "test": "tsx --test \"tests/**/*.test.ts\""
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
